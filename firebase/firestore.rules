rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activePromoCode(code) {
      return exists(/databases/$(database)/documents/promoCodes/$(code))
        && get(/databases/$(database)/documents/promoCodes/$(code)).data.active == true;
    }

    function validParticipantWrite(code) {
      return signedIn()
        && activePromoCode(code)
        && request.resource.data.keys().hasOnly([
          'promoCode',
          'customerName',
          'customerPhone',
          'customerPhoneNormalized',
          'eligibleForAllDraws',
          'status',
          'source',
          'createdAt',
          'updatedAt',
          'lastLoginAt',
          'lastAuthUid'
        ])
        && request.resource.data.promoCode == code
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 80
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() >= 7
        && request.resource.data.customerPhone.size() <= 24
        && request.resource.data.customerPhoneNormalized is string
        && request.resource.data.customerPhoneNormalized.size() >= 7
        && request.resource.data.customerPhoneNormalized.size() <= 16
        && request.resource.data.eligibleForAllDraws == true
        && request.resource.data.status == 'active'
        && request.resource.data.source == 'bereraci.md'
        && request.resource.data.lastAuthUid == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.lastLoginAt is timestamp;
    }

    match /promoCodes/{code} {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
    }

    match /tombolaParticipants/{code} {
      allow get: if signedIn() && activePromoCode(code);
      allow create, update: if validParticipantWrite(code);
      allow list, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
